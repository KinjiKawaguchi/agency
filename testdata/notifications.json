{
  "description": "Sequences of readings and the events each one makes, for the definition of what is new in the web client and the iPhone app (agency#167). Each case is read from its first step, which is a baseline. A team that could not be read (ok false) and a list that could not be read (null) keep their last answer and make no event. Events come ordered by kind (request, participant, blocked, device, decision), then by key in code point order. Keys: request:org/team/id, participant:org/team/id, blocked:org/team/ref, device:public key, decision:id:state.",
  "cases": [
    {
      "name": "the first reading is a baseline: nothing in it is new",
      "own": {
        "deviceKey": "own-key",
        "canApprove": true,
        "sentDecisionIds": []
      },
      "steps": [
        {
          "reading": {
            "teams": [
              {
                "org": "acme",
                "team": "app",
                "ok": true,
                "mine": [
                  "r-1",
                  "r-2"
                ],
                "waitingOnViewer": [
                  "backend"
                ],
                "blocked": [
                  {
                    "ref": "app#1",
                    "reason": "needsDecision"
                  }
                ]
              }
            ],
            "devices": [
              "k1"
            ],
            "decisions": [
              {
                "id": "d1",
                "state": "applied"
              }
            ]
          },
          "expected": []
        }
      ]
    },
