#!/usr/bin/env bash
# Stand-in for curl in the tests: records the request and answers from files in $FAKE_DIR.
#   $FAKE_LOG          one line per request: METHOD URL BODY
#   $FAKE_LOG.auth     the Authorization header curl was given on its standard input
#   $FAKE_DIR/bundle_ids.json, bundle_ids_mac.json (the macOS platform's), apps.json, app_store_versions.json,
#                      capabilities.json   what the GET requests answer; a bundle ID with its own
#                      capabilities-<resource id>.json answers from that file instead
#   $FAKE_DIR/status   when present, the HTTP status to answer instead of 200/201
method=GET output="" body="" url="" read_config=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) output="$2"; shift 2 ;;
    -X) method="$2"; shift 2 ;;
    -d) body="$2"; shift 2 ;;
    -K) read_config="$2"; shift 2 ;;
    -w | -H) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
if [ "$read_config" = "-" ]; then
  cat >> "$FAKE_LOG.auth"
fi
printf '%s %s %s\n' "$method" "$url" "$body" >> "$FAKE_LOG"

status=200
# The reads of the report on the Mac answer with this status when the file is there (a key that may not read them).
if [ -f "$FAKE_DIR/status_report" ]; then
  case "$method $url" in
    "GET "*"/v1/bundleIds?"*"MAC_OS"* | "GET "*"/v1/apps?"* | "GET "*"/appStoreVersions"*)
      printf '%s' '{"errors":[{"title":"Forbidden","detail":"This key may not read that."}]}' > "$output"
      printf '%s' "$(cat "$FAKE_DIR/status_report")"
      exit 0 ;;
  esac
fi
case "$method $url" in
  "GET "*"/v1/bundleIds?"*"MAC_OS"*) response=$(cat "$FAKE_DIR/bundle_ids_mac.json") ;;
  "GET "*"/v1/bundleIds?"*) response=$(cat "$FAKE_DIR/bundle_ids.json") ;;
  "GET "*"/v1/apps?"*) response=$(cat "$FAKE_DIR/apps.json") ;;
  "GET "*"/appStoreVersions"*) response=$(cat "$FAKE_DIR/app_store_versions.json") ;;
  "POST "*"/v1/appStoreVersions") status=201 response='{"data":{"id":"NEW-VERSION"}}' ;;
  # The real API refuses `limit` on this relationship.
  "GET "*"/bundleIdCapabilities"*limit*)
    status=400 response='{"errors":[{"title":"A given parameter is not allowed for this request","detail":"The parameter '"'"'limit'"'"' can not be used with this request : This relationship does not support this parameter."}]}' ;;
  "GET "*"/bundleIdCapabilities"*)
    resource=${url#*/v1/bundleIds/}
    resource=${resource%%/*}
    if [ -f "$FAKE_DIR/capabilities-$resource.json" ]; then
      response=$(cat "$FAKE_DIR/capabilities-$resource.json")
    else
      response=$(cat "$FAKE_DIR/capabilities.json")
    fi ;;
  "POST "*"/v1/bundleIds")
    status=201 response='{"data":{"id":"NEW-BUNDLE"}}'
    case "$body" in
      *.widgets*) response='{"data":{"id":"NEW-WIDGET"}}' ;;
      *.notifications*) response='{"data":{"id":"NEW-NOTIFICATIONS"}}' ;;
    esac ;;
  "POST "*"/v1/bundleIdCapabilities") status=201 response='{"data":{"id":"NEW-CAPABILITY"}}' ;;
  *) status=404 response='{"errors":[{"title":"Not found","detail":"no such route"}]}' ;;
esac
if [ -f "$FAKE_DIR/status" ]; then
  status=$(cat "$FAKE_DIR/status")
  response='{"errors":[{"title":"Forbidden","detail":"This key may not do that."}]}'
fi
printf '%s' "$response" > "$output"
printf '%s' "$status"
