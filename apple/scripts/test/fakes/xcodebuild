#!/usr/bin/env bash
# Stand-in for xcodebuild in the tests: records the call and leaves the files a real one would.
# FAKE_FAIL=archive or FAKE_FAIL=export makes that step fail.
printf 'xcodebuild %s\n' "$*" >> "$FAKE_LOG"
step=""
case "$1" in
  archive) step=archive ;;
  -exportArchive) step="export" ;;
esac
mkdir -p "$DERIVED_DATA_ROOT/Agency-abcdefghijklmnopqrstuvwxyzab"
if [ "${FAKE_FAIL:-}" = "$step" ]; then
  echo "xcodebuild: error: simulated failure" >&2
  exit 65
fi
while [ $# -gt 0 ]; do
  case "$1" in
    -archivePath | -exportPath | -derivedDataPath) mkdir -p "$2"; shift 2 ;;
    *) shift ;;
  esac
done
