{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "agency",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='agency-proto')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='agency-core')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='agency-adapters')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name=='agency-node')].version" },
        { "type": "json", "path": "web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/package-lock.json", "jsonpath": "$.packages[''].version" }
      ]
    }
  }
}
